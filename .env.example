# Copy to backend/.env and fill in real values. Never commit the real .env.

# --- Server ---
PORT=4000
NODE_ENV=development
# "*" (any origin) is fine for local dev. In production, set this to your
# deployed frontend's exact origin, e.g. https://your-app.vercel.app —
# see DEPLOYMENT.md.
CORS_ORIGIN=*

# --- Groq (LLM orchestration) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Automatically retried on a rate limit from GROQ_MODEL (free-tier daily
# token caps are per-model) — set equal to GROQ_MODEL to disable fallback.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Redis (session state) ---
# Local: redis://localhost:6379
# Hosted (e.g. Upstash): use the native connection string, NOT the REST API
# URL, and it must start with rediss:// (double s) for TLS — see README.
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=1800

# --- Zoho CRM (OAuth 2.0 Self Client) ---
# DC = data center suffix for your Zoho account: com | eu | in | com.au | jp
ZOHO_DC=com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Long-lived refresh token generated once via the Self Client grant flow (see README).
ZOHO_REFRESH_TOKEN=

# --- MongoDB (optional — conversation transcript/audit log only) ---
MONGO_ENABLED=false
MONGO_URI=mongodb://localhost:27017/chat-agent-audit

# Frontend env vars live in a separate file: see frontend/.env.example.
