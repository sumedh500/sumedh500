# Copy to backend/.env and fill in real values. Never commit the real .env.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Groq (LLM orchestration) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Redis (session state) ---
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=1800

# --- Zoho CRM (OAuth 2.0 Self Client) ---
# DC = data center suffix for your Zoho account: com | eu | in | com.au | jp
ZOHO_DC=com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Long-lived refresh token generated once via the Self Client grant flow (see README).
ZOHO_REFRESH_TOKEN=

# --- MongoDB (optional — conversation transcript/audit log only) ---
MONGO_ENABLED=false
MONGO_URI=mongodb://localhost:27017/chat-agent-audit

# --- Frontend (frontend/.env) ---
VITE_API_URL=http://localhost:4000
