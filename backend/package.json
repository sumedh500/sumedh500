{
  "name": "mahindra-chat-agent-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express + TypeScript backend for the multistage AI chat agent (Groq tool calling, Redis sessions, Zoho CRM integration).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "seed:zoho": "tsx scripts/seed-zoho.ts",
    "zoho:refresh-token": "tsx scripts/zoho-get-refresh-token.ts",
    "test:agent": "tsx scripts/test-agent.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "groq-sdk": "^0.9.1",
    "ioredis": "^5.4.2",
    "mongodb": "^6.12.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.1",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
